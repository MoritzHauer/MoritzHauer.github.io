---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { PROFILE } from '../../data/profile';
import { base } from '../../lib/public';

const posts = await getPosts();
const hasPersonal = posts.some((post) => post.data.kind === 'personal');

const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
---
<Base title={`Blog — ${PROFILE.name}`} description={PROFILE.blog.description}>
  <section>
    <h1>Blog</h1>
    <p class="lede">{PROFILE.blog.intro}</p>
  </section>

  <section>
    {hasPersonal && (
      <label class="switch"><input type="checkbox" role="switch" id="show-personal" /><span class="track"></span>Personal posts</label>
    )}
    <div class="posts">
      {posts.map((post) => (
        <a class="post-link" data-kind={post.data.kind} href={`${base}/blog/${post.id}`}>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
