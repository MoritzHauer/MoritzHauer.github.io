---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { SITE_NAME } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${post.data.title} — ${SITE_NAME}`} description={post.data.description}>
  <article class="article">
    <div class="article-meta">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      {post.data.tags.map((tag) => <span>#{tag}</span>)}
    </div>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
