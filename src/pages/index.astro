---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Timeline from '../components/Timeline.astro';
import { getPosts } from '../lib/posts';
import { PROFILE } from '../data/profile';
import { EXPERIENCE, STACK, CV, CERTS, TAG_ICONS } from '../data/cv';
import { base, publicFile } from '../lib/public';

const cvFiles = CV.map((c) => ({ ...c, href: publicFile(`cv/${c.file}`) })).filter((c) => c.href);
const certs = [...CERTS].sort((a, b) => b.date - a.date).map((c) => ({ ...c, href: publicFile(c.file && `certificates/${c.file}`) }));
const posts = (await getPosts()).filter((post) => post.data.kind === 'engineering').slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
const tagIcons = { ...TAG_ICONS, ...Object.fromEntries(STACK.flatMap((g) => g.items).map((t) => [t.name, t.icon])) };
const bare = (url) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base title={PROFILE.name}>
  <section class="hero">
    <h1>{PROFILE.hero.title}</h1>
    <p class="lede">{PROFILE.hero.intro} <strong>{PROFILE.hero.highlight}</strong></p>
    <p><span class="status"><i></i> {PROFILE.status}</span></p>
  </section>

  <section class="path" aria-label="Career path">
    <Timeline />
  </section>

  <section>
    <p class="label">Experience</p>
    <ol class="jobs">
      {EXPERIENCE.map((job) => (
        <li class="job">
          {job.logo ? <img class="job-logo" src={`${base}/logos/${job.logo}`} alt="" width="40" height="40" loading="lazy" /> : <span></span>}
          <div>
            <div class="job-top">
              <h3>{job.role} <span>· {job.org}</span></h3>
              <span class="job-when">{job.when} · {job.place}</span>
            </div>
            <ul>{job.points.map((point) => <li>{point}</li>)}</ul>
            <div class="stack">{job.stack.map((tech) => <span>{tagIcons[tech] && <i style={`--src: url(${base}/logos/tech/${tagIcons[tech]}.svg)`} aria-hidden="true"></i>}{tech}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {PROFILE.projects.length > 0 && (
    <section>
      <p class="label">Projects</p>
      {PROFILE.projects.map((p) => (
        <div class="project">
          {p.image && <img class="project-img" src={`${base}/logos/${p.image}`} alt={p.imageAlt} width="72" height="72" />}
          <div>
            <div class="project-top">
              <h3>{p.name}</h3>
              {p.url && <a href={p.url}>{bare(p.url)}</a>}
            </div>
            <p class="project-summary">{p.summary}</p>
            <ul>{p.points.map((point) => <li>{point}</li>)}</ul>
            <div class="stack">{p.stack.map((tech) => <span>{tagIcons[tech] && <i style={`--src: url(${base}/logos/tech/${tagIcons[tech]}.svg)`} aria-hidden="true"></i>}{tech}</span>)}</div>
          </div>
        </div>
      ))}
    </section>
  )}

  <section>
    <p class="label">Tech stack</p>
    <div class="tech">
      {STACK.map((g) => (
        <div class="tech-group">
          <h3>{g.group}</h3>
          <ul>
            {g.items.map((t) => (
              <li>
                {t.icon && <i style={`--src: url(${base}/logos/tech/${t.icon}.svg)`} aria-hidden="true"></i>}
                {t.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {cvFiles.length > 0 && (
    <section>
      <p class="label">CV</p>
      <p class="cv-links">
        {cvFiles.map((c) => (
          <a class="cv-link" href={c.href} data-title={`CV · ${c.label}`} hreflang={c.lang} lang={c.lang}><Icon name="post" />{c.label} <small>PDF</small></a>
        ))}
      </p>
    </section>
  )}

  {certs.length > 0 && (
    <section>
      <p class="label">Certificates</p>
      <ul class="certs">
        {certs.map((c) => (
          <li>
            <span class="cert-icon"><Icon name="cert" class="" /></span>
            <div>
              <h3>{c.href ? <a href={c.href}>{c.title} <small>PDF</small></a> : c.title}</h3>
              <span>{c.org} · {c.when}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <p class="label">Contact</p>
    <p class="lede">{PROFILE.contact}</p>
    {PROFILE.email && (
      <form class="contact-form" action={`mailto:${PROFILE.email}`} method="post" enctype="text/plain">
        <div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="cf-email">Your email</label><input id="cf-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field wide"><label for="cf-message">Message</label><textarea id="cf-message" name="message" rows="5" required></textarea></div>
        <div class="form-foot wide"><button type="submit">Send message</button></div>
      </form>
    )}
    <p>
      <a href={PROFILE.github}><Icon name="github" />{bare(PROFILE.github)}</a> &middot;
      <a href={PROFILE.linkedin}><Icon name="linkedin" />LinkedIn</a>
    </p>
  </section>

  {posts.length > 0 && (
    <section>
      <p class="label">Blog</p>
      <div class="posts">
        {posts.map((post) => (
          <a class="post-link" href={`${base}/blog/${post.id}`}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* PDF preview for the CV and certificate links. pdf.js draws the pages, so no browser viewer controls show up. */}
  <dialog class="pdf-view" aria-label="PDF preview">
    <form method="dialog"><button class="pdf-close" aria-label="Close">&times;</button></form>
    <div class="pdf-pages"></div>
  </dialog>
  <script>
    const dlg = document.querySelector('.pdf-view');
    const pages = dlg.querySelector('.pdf-pages');
    let opened = 0;

    document.addEventListener('click', async (e) => {
      const a = e.target.closest('a[href$=".pdf"]');
      if (!a || e.defaultPrevented || e.button || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      const run = ++opened;
      dlg.setAttribute('aria-label', a.dataset.title ?? a.textContent.replace(/\s*PDF\s*$/, '').trim());
      pages.replaceChildren();
      dlg.showModal();
      try {
        // Loaded on first use only: pdf.js is the heaviest thing on the page.
        const [pdfjs, { default: worker }] = await Promise.all([import('pdfjs-dist'), import('pdfjs-dist/build/pdf.worker.min.mjs?url')]);
        pdfjs.GlobalWorkerOptions.workerSrc = worker;
        const doc = await pdfjs.getDocument({ url: a.href }).promise;
        for (let n = 1; n <= doc.numPages; n++) {
          const page = await doc.getPage(n);
          const viewport = page.getViewport({ scale: (pages.clientWidth / page.getViewport({ scale: 1 }).width) * devicePixelRatio });
          const canvas = Object.assign(document.createElement('canvas'), { width: viewport.width, height: viewport.height });
          canvas.setAttribute('role', 'img');
          canvas.setAttribute('aria-label', `Page ${n} of ${doc.numPages}`);
          await page.render({ canvas, canvasContext: canvas.getContext('2d'), viewport }).promise;
          if (run !== opened || !dlg.open) return; // closed or replaced while rendering
          pages.append(canvas);
        }
      } catch {
        if (run === opened) location.href = a.href; // could not render: show the file the normal way
      }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  </script>
</Base>
