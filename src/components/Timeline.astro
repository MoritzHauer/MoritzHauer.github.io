---
import { getPosts, happenedAt } from '../lib/posts';
import Icon from './Icon.astro';
import { STEPS as CONTENT_STEPS, NEXT, SIDE, TOPICS as CONTENT_TOPICS } from '../data/timeline';
import { CERTS } from '../data/cv';
import { base, publicFile } from '../lib/public';
import Sprites from '../themes/Sprites.astro';

// Certificates are steps too, marked `cert` so their legend switch can hide them.
// Date order drives both the step spacing and which gap a post falls into, so never trust the file order.
// Career steps keep the colour cycle to themselves; certificates share one colour.
let colour = 0;
const STEPS = [...CONTENT_STEPS, ...CERTS.map((c) => ({ ...c, cert: true, icon: 'cert', href: publicFile(c.file && `certificates/${c.file}`) }))]
  .sort((a, b) => a.date - b.date)
  .map((s) => ({ ...s, c: s.cert ? 'var(--link)' : `var(--c${colour++ % 6})` }));
const logo = (file) => `${base}/logos/${file}`;

// Posts whose tags match no topic get a plain page icon.
const TOPICS = { ...CONTENT_TOPICS, post: { color: '#6B7280', icon: 'post' } };

const yearOf = (d) => d.getUTCFullYear() + d.getUTCMonth() / 12;
const month = (d) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const posts = (await getPosts()).map((p) => ({
  date: p.data.happened ? happenedAt(p.data.happened).year : yearOf(p.data.date),
  kind: p.data.happened ? `Blog post · about ${happenedAt(p.data.happened).label}` : `Blog post · ${month(p.data.date)}`,
  title: p.data.title,
  desc: p.data.description,
  topic: p.data.tags.find((t) => t in TOPICS) ?? 'post',
  href: `${base}/blog/${p.id}`,
  cta: 'Read the post',
}));
const extras = [...SIDE, ...posts].sort((a, b) => a.date - b.date);
---
<div class="timeline hide-extras">
  <div class="scene-scroll" tabindex="0" aria-label="Career path, scrolls sideways on small screens">
    <div class="scene">
      <svg class="world" aria-hidden="true"></svg>
      <svg class="leaders" aria-hidden="true"></svg>

      <div class="follower" aria-hidden="true">
        <Sprites />
      </div>

      <div class="overlay">
        {STEPS.map((s) => {
          const Label = s.href ? 'a' : 'div';
          return (
            <Fragment>
              <div class:list={['node', { cert: s.cert }]} data-date={s.date} style={`--c:${s.c}`}></div>
              <Label class:list={['plabel', { cert: s.cert }]} href={s.href} tabindex={s.href ? undefined : '0'} style={`--c:${s.c}`}
                data-kind={`${s.cert ? 'Certificate' : 'Career'} · ${s.when}`} data-title={`${s.title} · ${s.org}`} data-desc={s.note}
                data-cta={s.href && 'Open the certificate (PDF)'} aria-describedby="tl-pop">
                {s.logo ? <img class="tile" src={logo(s.logo)} alt="" width="32" height="32" /> : <span class="tile"><Icon name={s.icon ?? 'cert'} class="" /></span>}
                <span class="yr">{s.when}</span>
                <h3>{s.title}</h3>
                <span class="org">{s.org}</span>
              </Label>
            </Fragment>
          );
        })}
        {extras.map((e) => {
          const t = TOPICS[e.topic] ?? TOPICS.post;
          return (
            <a class={`ticon marker extra${t.photo ? ' photo' : ''}`} style={`--t:${t.color}`} data-date={e.date}
              href={e.href} target={e.href.startsWith('http') ? '_blank' : undefined} rel="noopener"
              data-kind={e.kind} data-title={e.title} data-desc={e.desc} data-cta={e.cta} aria-label={e.title} aria-describedby="tl-pop">
              {t.img ? <img src={logo(t.img)} alt="" /> : <Icon name={t.icon} class="" />}
            </a>
          );
        })}
        <div class="endflag"><Icon name="flag" class="" /></div>
        <div class="endlabel" style="--c:var(--ink)"><span class="yr">next</span><strong>{NEXT}</strong></div>
      </div>
    </div>
  </div>

  <div class="tl-legend">
    <label class="switch"><input type="checkbox" role="switch" data-hides="extras" /><span class="track"></span>Blog</label>
    {CERTS.length > 0 && <label class="switch"><input type="checkbox" role="switch" data-hides="certs" checked /><span class="track"></span>Certificates</label>}
    <span class="key"><i class="k-step"></i>Career step</span>
    <span class="key extra"><i class="k-post"></i>Post or project, hover to preview</span>
    <span class="key"><i class="k-next"></i>What&rsquo;s next</span>
  </div>

  <div id="tl-pop" class="tl-pop" role="tooltip" hidden><span class="kind"></span><strong></strong><p></p><span class="cta"></span></div>
  <div class="tl-list" hidden><ul></ul></div>
</div>

<script>
  import { drawScenery } from '../themes/scenery';

  const timeline = document.querySelector('.timeline');
  if (timeline) initTimeline(timeline);

  function initTimeline(tl) {
    const scene = tl.querySelector('.scene');
    const world = scene.querySelector('.world');
    const leaders = scene.querySelector('.leaders');
    const follower = scene.querySelector('.follower');
    const overlay = scene.querySelector('.overlay');
    const nodes = [...scene.querySelectorAll('.node')];
    const labels = [...scene.querySelectorAll('.plabel')];
    const markers = [...scene.querySelectorAll('.marker')];
    const flag = scene.querySelector('.endflag');
    const endLabel = scene.querySelector('.endlabel');
    const root = document.documentElement;
    // Visible steps as [node, label] pairs: certificates drop out while their switch is off.
    const shownSteps = () => nodes.map((n, i) => [n, labels[i]]).filter(([n]) => !(n.classList.contains('cert') && tl.classList.contains('hide-certs')));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const f = (n) => n.toFixed(1);

    // The road in units: x runs 0..1000 across the content column, y 0..500 down the scene.
    // Only slow sines, so the bends vary in height but never kink. Unrelated to the steps on purpose.
    // The Gaussian bend adds a curve in the middle of the right half, where the sines alone run almost flat.
    const yOf = (u) => {
      const amp = 50 + 32 * Math.sin(u * 0.0047 + 0.9);
      const phase = u * 0.0115 + 1.3 * Math.sin(u * 0.0023 + 0.4);
      const bend = -80 * Math.exp(-(((u - 790) / 95) ** 2));
      return 290 + amp * Math.sin(phase) + 22 * Math.sin(u * 0.006 + 2.1) + bend;
    };
    // ---------- Sizing ----------
    // Steps are spaced in "units" of road: a step carries a label, so it gets more room than the end flag.
    // UNIT is the minimum road length per unit; with more steps than that allows, the scene widens and scrolls.
    const UNIT = 48, STEP_W = 2.25, FLAG_W = 1.5, MIN_SCENE = 832;
    // Posts and side projects sit between steps: at least ICON_GAP apart and CLEAR away from a step or the flag.
    const ICON_GAP = 42, CLEAR = 40;
    let sizedUnits = -1, sizedPx = 0;

    let G = null;
    function geometry() {
      const S = scene.clientWidth, H = scene.clientHeight;
      // Column is capped at 1320px, unless fitWidth widened the scene for more steps; then it uses all of it.
      const C = Math.min(Math.max(1320, sizedPx - 80), S - 80), left = (S - C) / 2, k = H / 500;
      const toU = (x) => ((x - left) / C) * 1000, toX = (u) => left + (u / 1000) * C;
      const STEP = 3, X0 = -12, pts = [];
      for (let x = X0; x <= S + 12; x += STEP) pts.push([x, yOf(toU(x)) * k]);
      const cum = [0];
      for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(STEP, pts[i][1] - pts[i - 1][1]));
      const idx = (x) => Math.max(0, Math.min(pts.length - 2, Math.floor((x - X0) / STEP)));
      const yAt = (x) => { const i = idx(x); return pts[i][1] + (pts[i + 1][1] - pts[i][1]) * ((x - pts[i][0]) / STEP); };
      const slopeAt = (x) => (yAt(x + 3) - yAt(x - 3)) / 6;
      const lengthAt = (x) => { const i = idx(x); return cum[i] + (cum[i + 1] - cum[i]) * ((x - pts[i][0]) / STEP); };
      const pointAt = (l) => {
        let lo = 0, hi = cum.length - 1;
        while (hi - lo > 1) { const m = (lo + hi) >> 1; if (cum[m] < l) lo = m; else hi = m; }
        const t = (l - cum[lo]) / (cum[hi] - cum[lo] || 1);
        return [pts[lo][0] + STEP * t, pts[lo][1] + (pts[hi][1] - pts[lo][1]) * t];
      };
      // Catmull-Rom through every 4th sample: smooth curve, short path string.
      const P = pts.filter((_, i) => i % 4 === 0);
      let road = `M${f(P[0][0])},${f(P[0][1])}`;
      for (let i = 0; i < P.length - 1; i++) {
        const p0 = P[i - 1] || P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] || p2;
        road += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
      }
      return { S, H, C, left, toU, toX, pts, yAt, slopeAt, lengthAt, pointAt, road };
    }

    // ---------- Points on the road ----------
    const put = (el, [x, y]) => { el.style.left = `${x}px`; el.style.top = `${y}px`; el.dataset.ax = String(x); el.dataset.ay = String(y); };
    const extrasOn = () => !tl.classList.contains('hide-extras');

    // Steps and the end flag are spaced evenly by weight and never depend on the blog switch,
    // so they do not move when it is toggled; the certificate switch does respace them. Returns the units used, for fitWidth.
    function placeSteps() {
      const { left, C, lengthAt, pointAt } = G;
      const Ls = lengthAt(left), span = lengthAt(left + C) - Ls;
      const shown = shownSteps();
      const weights = [...shown.map(() => STEP_W), FLAG_W];
      const at = [0];
      for (let i = 1; i < weights.length; i++) at.push(at[i - 1] + (weights[i - 1] + weights[i]) / 2);
      const units = at[at.length - 1] || 1;
      const anchors = at.map((a) => Ls + span * (0.02 + 0.965 * (a / units)));
      shown.forEach(([n, l], i) => { const p = pointAt(anchors[i]); put(n, p); put(l, p); });
      const end = pointAt(anchors[anchors.length - 1]);
      put(flag, end);
      put(endLabel, end);
      return { units, anchors, start: Ls };
    }

    // Each post or side project goes into the gap between the two steps its date falls between,
    // near its date, at least ICON_GAP from its neighbours. A gap too short for all of them gets
    // one stacked badge instead, which lists them on hover or tap.
    let clusters = [];
    function placeExtras({ anchors, start }) {
      clusters.forEach((c) => c.remove());
      clusters = [];
      markers.forEach((m) => m.classList.remove('stacked'));
      if (!extrasOn()) return;
      const today = new Date();
      const dates = [...shownSteps().map(([n]) => Number(n.dataset.date)), today.getFullYear() + today.getMonth() / 12];
      const gaps = new Map();
      for (const m of markers) {
        let k = dates.findIndex((d) => Number(m.dataset.date) < d);
        if (k === -1) k = dates.length - 1;
        if (!gaps.has(k)) gaps.set(k, []);
        gaps.get(k).push(m);
      }
      gaps.forEach((items, k) => {
        const a = (k === 0 ? start : anchors[k - 1]) + CLEAR, b = anchors[k] - CLEAR;
        if (b - a < (items.length - 1) * ICON_GAP) return stack(items, Math.max(a, (a + b) / 2));
        const d0 = k === 0 ? dates[0] - 1 : dates[k - 1], d1 = dates[k];
        const L = items.map((m) => a + (b - a) * Math.min(1, Math.max(0, (Number(m.dataset.date) - d0) / (d1 - d0 || 1))));
        for (let j = 0; j < L.length; j++) L[j] = Math.max(L[j], j ? L[j - 1] + ICON_GAP : a);
        for (let j = L.length - 1; j >= 0; j--) L[j] = Math.min(L[j], j === L.length - 1 ? b : L[j + 1] - ICON_GAP);
        items.forEach((m, j) => put(m, G.pointAt(L[j])));
      });
    }
    function stack(items, at) {
      const badge = document.createElement('button');
      badge.type = 'button';
      badge.className = 'ticon marker cluster extra';
      badge.textContent = String(items.length);
      badge.setAttribute('aria-label', `${items.length} posts and projects`);
      badge.setAttribute('aria-haspopup', 'true');
      items.forEach((m) => m.classList.add('stacked'));
      overlay.appendChild(badge);
      put(badge, G.pointAt(at));
      wireList(badge, items);
      clusters.push(badge);
    }

    // Labels alternate above and below the road. Each sits just clear of the road and of every point
    // under its own width, moves further out if it would touch a neighbour, and switches sides if it
    // does not fit. A leader line joins each label to its point.
    function layout() {
      if (!G) return;
      const { H, left, C, pts } = G;
      // Clear the road, and the 16px-radius icons that can stick out of a narrow road.
      const pad = Math.max(parseFloat(getComputedStyle(root).getPropertyValue('--road-half')) || 10, 18) + 8;
      const roadY = (x0, x1, pick, start) => pts.reduce((v, [px, py]) => (px >= x0 && px <= x1 ? pick(v, py) : v), start);
      const placed = [];
      const clash = (x, y, w, h) => placed.find((o) => x < o.x + o.w + 8 && o.x < x + w + 8 && y < o.y + o.h + 8 && o.y < y + h + 8);
      const lines = [];
      let side = 1;
      [...shownSteps().map(([, l]) => l), endLabel].sort((p, q) => Number(p.dataset.ax) - Number(q.dataset.ax)).forEach((el) => {
        const ax = Number(el.dataset.ax), ay = Number(el.dataset.ay), w = el.offsetWidth, h = el.offsetHeight;
        const x = Math.max(left, Math.min(left + C - w, ax - w / 2));
        const top = roadY(x - 8, x + w + 8, Math.min, Infinity), bottom = roadY(x - 8, x + w + 8, Math.max, -Infinity);
        const attempt = (s) => {
          let y = s < 0 ? top - pad - h : bottom + pad;
          for (let n = 0, o = clash(x, y, w, h); o && n < 12; n++, o = clash(x, y, w, h)) y = s < 0 ? o.y - h - 8 : o.y + o.h + 8;
          return { s, y, fits: y >= 4 && y + h <= H - 4 };
        };
        let r = attempt(-side);
        if (!r.fits) { const alt = attempt(side); if (alt.fits) r = alt; }
        side = r.s;
        // Nothing fits on either side: stay inside the scene, even if that touches a neighbour.
        const y = Math.max(4, Math.min(H - 4 - h, r.y));
        el.style.transform = `translate(${x - ax}px, ${y - ay}px)`;
        placed.push({ x, y, w, h });
        const nx = Math.max(x, Math.min(ax, x + w)), ny = Math.max(y, Math.min(ay, y + h));
        const dist = Math.hypot(nx - ax, ny - ay);
        if (dist > 16) {
          const sx = ax + ((nx - ax) / dist) * 13, sy = ay + ((ny - ay) / dist) * 13;
          lines.push(`<path d="M${f(sx)},${f(sy)} L${f(nx)},${f(ny)}" style="stroke:${el.style.getPropertyValue('--c')}"/><circle cx="${f(nx)}" cy="${f(ny)}" r="2.5" style="fill:${el.style.getPropertyValue('--c')}"/>`);
        }
      });
      leaders.innerHTML = lines.join('');
    }

    // ---------- Follower: a train, beaver or robot that glides toward the mouse ----------
    let fx = null, tx = null, facing = 1, raf = 0, last = 0;
    function moveFollower() {
      follower.style.transform = `translate(${f(fx)}px, ${f(G.yAt(fx))}px)`;
      follower.style.setProperty('--angle', `${f((Math.atan(G.slopeAt(fx)) * 180) / Math.PI)}deg`);
      follower.style.setProperty('--facing', String(facing));
    }
    function tick(t) {
      const dt = Math.max(0, Math.min(0.05, (t - last) / 1000));
      last = t;
      const max = 520 * dt;
      fx += Math.max(-max, Math.min(max, (tx - fx) * (1 - Math.exp(-dt * 3))));
      moveFollower();
      raf = Math.abs(tx - fx) > 0.3 ? requestAnimationFrame(tick) : 0;
    }
    scene.addEventListener('pointermove', (e) => {
      if (!G) return;
      tx = Math.max(0, Math.min(G.S, e.clientX - scene.getBoundingClientRect().left));
      if (Math.abs(tx - fx) > 4) facing = tx > fx ? 1 : -1;
      if (reduced.matches) { fx = tx; moveFollower(); return; }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
    });

    // Width the scene needs so every step unit keeps UNIT px of road. Only grows while the step count is
    // unchanged, because the road/width ratio shifts a little with width and could otherwise flip-flop.
    function fitWidth(units) {
      const ratio = (G.lengthAt(G.left + G.C) - G.lengthAt(G.left)) / G.C;
      const needed = Math.ceil(((units * UNIT) / 0.965 / ratio + 80) / 50) * 50;
      const px = needed > MIN_SCENE ? needed : 0;
      if (units === sizedUnits && px <= sizedPx) return false;
      sizedUnits = units;
      if (px === sizedPx) return false;
      sizedPx = px;
      scene.style.minWidth = px ? `${px}px` : '';
      return true;
    }

    function render() {
      G = geometry();
      if (G.S <= 0) return;
      let steps = placeSteps();
      if (fitWidth(steps.units)) { G = geometry(); steps = placeSteps(); }
      placeExtras(steps);
      for (const svg of [world, leaders]) svg.setAttribute('viewBox', `0 0 ${G.S} ${G.H}`);
      world.innerHTML = drawScenery(root.dataset.look, G);
      layout();
      fx = fx === null ? Number(shownSteps()[0]?.[0].dataset.ax ?? 0) : Math.min(fx, G.S);
      tx = tx === null ? fx : Math.min(tx, G.S);
      moveFollower();
      scene.classList.add('ready');
    }
    // Label sizes change when a theme swaps fonts, and those fonts load lazily.
    const afterFonts = () => { document.fonts?.ready.then(layout); setTimeout(layout, 600); };
    new ResizeObserver(() => requestAnimationFrame(render)).observe(scene);
    new MutationObserver(() => { render(); afterFonts(); }).observe(root, { attributeFilter: ['data-look'] });
    afterFonts();

    // ---------- Legend switches: each hides one group (class hide-<data-hides>) and redraws ----------
    tl.querySelectorAll('.switch input').forEach((toggle) => {
      // Sync once up front: the browser may restore a checkbox state that differs from the markup.
      const apply = () => tl.classList.toggle(`hide-${toggle.dataset.hides}`, !toggle.checked);
      apply();
      toggle.addEventListener('change', () => {
        apply();
        hide();
        hideList();
        render();
      });
    });

    // ---------- Preview: only while hovered, or while keyboard focus is on the item ----------
    const pop = tl.querySelector('.tl-pop');
    const hide = () => { pop.hidden = true; };
    const below = (el, panel) => {
      const r = el.getBoundingClientRect(), w = panel.offsetWidth, h = panel.offsetHeight;
      panel.style.left = `${Math.min(Math.max(16, r.left + r.width / 2 - w / 2), window.innerWidth - w - 16)}px`;
      panel.style.top = `${r.top - h - 10 < 80 ? r.bottom + 10 : r.top - h - 10}px`;
    };
    function show(el) {
      pop.querySelector('.kind').textContent = el.dataset.kind;
      pop.querySelector('strong').textContent = el.dataset.title;
      pop.querySelector('p').textContent = el.dataset.desc;
      pop.querySelector('.cta').textContent = el.dataset.cta ? `Click: ${el.dataset.cta} →` : '';
      pop.hidden = false;
      below(el, pop);
    }
    scene.querySelectorAll('[data-title]').forEach((el) => {
      el.addEventListener('pointerenter', () => show(el));
      el.addEventListener('pointerleave', hide);
      el.addEventListener('focus', () => { if (el.matches(':focus-visible')) show(el); });
      el.addEventListener('blur', hide);
    });

    // ---------- Stacked badge list: stays open while the pointer is on the badge or the list ----------
    const list = tl.querySelector('.tl-list');
    let listTimer = 0, listOwner = null;
    function hideList() { clearTimeout(listTimer); list.hidden = true; listOwner = null; }
    const hideListSoon = () => { clearTimeout(listTimer); listTimer = setTimeout(hideList, 180); };
    function openList(badge, items) {
      clearTimeout(listTimer);
      hide();
      const ul = list.querySelector('ul');
      ul.replaceChildren(...items.map((m) => {
        const a = document.createElement('a');
        a.href = m.getAttribute('href');
        if (m.target) { a.target = m.target; a.rel = 'noopener'; }
        const mini = document.createElement('span');
        mini.className = `mini${m.classList.contains('photo') ? ' photo' : ''}`;
        mini.style.setProperty('--t', m.style.getPropertyValue('--t'));
        mini.innerHTML = m.innerHTML;
        const text = document.createElement('span');
        const title = document.createElement('b');
        title.textContent = m.dataset.title;
        const kind = document.createElement('small');
        kind.textContent = m.dataset.kind;
        text.append(title, kind);
        a.append(mini, text);
        const li = document.createElement('li');
        li.append(a);
        return li;
      }));
      list.hidden = false;
      listOwner = badge;
      below(badge, list);
    }
    function wireList(badge, items) {
      badge.addEventListener('pointerenter', () => openList(badge, items));
      badge.addEventListener('pointerleave', hideListSoon);
      badge.addEventListener('click', () => (listOwner === badge && !list.hidden ? hideList() : openList(badge, items)));
    }
    list.addEventListener('pointerenter', () => clearTimeout(listTimer));
    list.addEventListener('pointerleave', hideListSoon);
    list.addEventListener('focusout', (e) => { if (!list.contains(e.relatedTarget) && e.relatedTarget !== listOwner) hideListSoon(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !list.hidden) { listOwner?.focus(); hideList(); } });

    document.addEventListener('scroll', () => { hide(); hideList(); }, true);
  }
</script>
